# Get a free Groq API key at https://console.groq.com/keys
# (no credit card; very generous free tier on Llama 3.3 70B + Whisper)
GROQ_API_KEY=your-key-here

# Optional: swap to whisper-large-v3-turbo for ~2x faster transcription
# at a small accuracy cost. whisper-large-v3 is the default.
# GROQ_WHISPER_MODEL=whisper-large-v3

DATABASE_URL=sqlite:///./multilevel.db
AUDIO_UPLOAD_DIR=./audio_uploads
DEBUG=false
